# 复制为 .env 并填入本机密钥。.env 已在 .gitignore 中，绝不提交。
# 支持任何 OpenAI 兼容端点（官方 / DeepSeek / 通义 / 本地 vLLM / Ollama 均可）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=40

# 位图工程图识读用的多模态模型（留空则沿用 LLM_MODEL）
# 需支持 image_url 输入，如 gpt-4o / qwen-vl-max；未配置 Key 时位图通路直接明确报错
CNC_VISION_MODEL=

# 目标机型 ID：python main.py machines 查看全部
# 机型决定行程/转速/进给/功率极限、后置方言、工艺策略、通信协议与派生功能
CNC_MACHINE=vmc850_fanuc

# 后置方言覆盖：留空 = 跟随机型；填 FANUC / SIEMENS / HNC 才强制覆盖
CNC_CONTROLLER=

# 仿真网格分辨率 mm（越小越精确越慢）
SIM_RESOLUTION=0.5

# 校验/仿真失败后的最大自修复轮数
MAX_REPAIR_ROUNDS=3
STRICT_SIMULATION=1

# 视觉监控：自训练 YOLO 权重路径（留空则用离线像素启发式后端）
# COCO 权重不适用，需用机加工故障数据集训练
YOLO_WEIGHTS=

# 工业协议：auto 按机型推荐；可选 dryrun / modbus / opcua / mqtt
VISION_PROTOCOL=dryrun

# 是否允许 AI 建议急停。默认 0 = 急停必须经人工确认或硬件安全 PLC
# 即使设为 1，适配器仍不会对急停做软写
ALLOW_AUTO_STOP=0

# ================= 操控面板 / 机床直连 =================
# 服务绑定：本地调试用 127.0.0.1；车间内网经 Nginx 反代时才改 0.0.0.0
PANEL_HOST=127.0.0.1
PANEL_PORT=8787

# 访问令牌：留空 = 本机免鉴权；上线必须设置强随机令牌（HttpOnly Cookie）
PANEL_TOKEN=

# 写入总开关：0 = 只读遥测（生产默认）；1 = 允许白名单指令真实写入
# 开启后仍需连接时勾选「启用控制写入」+ 每次指令二次确认
PANEL_ALLOW_WRITE=0

# demo = 本机全功能（闭环仍 dry-run）；readonly = 公网只读镜像，禁用全部执行类 API
PANEL_MODE=demo

# 仅用于本地验证的虚拟机床网关地址（python panel/plc_sim.py）
# 接真机时把面板「网关地址/端口」改成车间 PLC 网关，并核对寄存器映射
PLC_SIM_HOST=127.0.0.1
PLC_SIM_PORT=15020
